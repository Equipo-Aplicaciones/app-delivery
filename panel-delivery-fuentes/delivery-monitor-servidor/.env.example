# Copie este archivo a .env y rellene los valores en el servidor.
# No pegue secretos en un chat. Genere claves en la terminal (ver README).

DOMAIN=panel.example.com

# Usuario del panel (obligatorio, sin valor por defecto).
PANEL_USER=

# Contraseña del panel: al menos 12 caracteres, no use ejemplos ni claves débiles.
# Alternativa: PANEL_PASSWORD_FILE=/sessions/panel_password
PANEL_PASSWORD=

# Secreto para firmar la cookie de sesión (al menos 32 caracteres aleatorios).
SESSION_SECRET=

# true detrás de Caddy con HTTPS. false solo en pruebas HTTP locales.
SESSION_SECURE=true
SESSION_HOURS=12

# 0 = solo refresh manual. Si lo activa, mínimo 15 minutos. No corre al arrancar.
REFRESH_INTERVAL_MINUTES=0
REFRESH_TIMEOUT=420

SNAPSHOT_PATH=/app/data/snapshot.json
UBER_CLI=/app/clients/uber/uber.py
UBER_CLI_CWD=/app/clients/uber
PYA_CLI=/app/clients/pya/pya.py
PYA_CLI_CWD=/app/clients/pya

TZ=America/Santiago

# Fotos de reclamo (no van a git; acceso solo con sesión) y sesiones de plataforma.
MEDIA_DIR=/app/media
SESSIONS_DIR=/sessions

# API de evidencia de la app delivery (Edge Function de Supabase).
# La clave sale de public.evidencia_clave; no la pegue en un chat ni la versione.
# Alternativa: EVIDENCIA_API_KEY_FILE=/sessions/evidencia_api_key
EVIDENCIA_URL=
EVIDENCIA_API_KEY=

# Envío real de disputas Uber (uber.py dispute --yes). Apagado hasta que el dueño
# autorice una prueba en vivo con un pedido de bajo monto.
ALLOW_UBER_DISPUTE_SUBMIT=false

# Automatizaciones con cron (hora de Chile). Solo refresh y reportes; las escrituras
# programadas (pausar, agotar, activar menú) quedan bloqueadas.
AUTOMATIONS_SCHEDULER=true
ALLOW_SCHEDULED_WRITES=false

# Límite de solicitudes por minuto para cada API key de agente.
AGENT_RATE_LIMIT_PER_MIN=120

# Deje vacío para Let's Encrypt (puertos 80 y 443 + DNS A/AAAA).
# Para un ensayo local sin dominio real: CADDY_TLS=internal
CADDY_TLS=
ACME_EMAIL=
